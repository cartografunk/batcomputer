APP_ENV=development
# En Railway, use el rol batcomputer_app y la conexión directa o Session pooler de Supabase.
DATABASE_URL=sqlite:///./local.db
LANGGRAPH_SQLITE_PATH=./langgraph_state.sqlite
# Secreto del servidor para firmar sesiones anónimas; también permite Bearer legacy en la API.
AUTH_TOKENS=replace-with-a-long-random-local-token
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
# Opcional: modelo ligero del mismo proveedor y clave para Router.
ROUTER_MODEL_NAME=
MODEL_MODE=remote
# "http" = cliente original. "langchain" = trazas por agente, tokens y modelos por rol (docs/EVALS.md).
MODEL_BACKEND=http
# Solo con MODEL_BACKEND=langchain. Roles: router, question, planner, coder, reviewer.
# Proveedores: remote (MODEL_BASE_URL), openai, anthropic, openrouter, google, azure, azure_responses, ollama.
# Ejemplo: ROLE_MODELS=router=openai:gpt-5-mini,reviewer=anthropic:claude-sonnet-5-5
ROLE_MODELS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
MAX_OUTPUT_TOKENS=16384
# Azure Responses: cambie MODEL_MODE=azure_responses y configure estos valores. MODEL_API_KEY es la clave Azure.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=
AZURE_MAX_COMPLETION_TOKENS=16384
# Solo si MODEL_MODE=ollama; en Docker use una dirección alcanzable desde el contenedor.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL_NAME=deepseek-coder
# Opcional: API Gemini para roles concretos, p. ej. GEMINI_ROLES=reviewer.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.8-flash
GEMINI_ROLES=
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=3
TAVILY_TIMEOUT_SECONDS=10
MAX_CODER_ATTEMPTS=3
MAX_JOB_RECOVERIES=2
MAX_CONCURRENT_RUNS=2
MAX_QUEUED_RUNS_PER_OWNER=10
MODEL_API_RETRIES=2
MODEL_TIMEOUT_SECONDS=120
JOB_STALE_SECONDS=180
WORKER_POLL_SECONDS=1
RATE_LIMIT_PER_HOUR=30
GLOBAL_RATE_LIMIT_PER_HOUR=100
CORS_ORIGINS=http://localhost:8000
E2B_API_KEY=
SANDBOX_TIMEOUT_SECONDS=45
SANDBOX_OUTPUT_CHARS=4000
FRONTEND_DIR=app/static
SHUTDOWN_GRACE_SECONDS=10
# Trazas en LangSmith. Se envían tickets y código generado; nunca claves.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=batcomputer
# Solo para la región EU: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=
# Juez de la batería de evaluación (python -m evals). Ideal: familia distinta a la del Coder.
JUDGE_MODEL=
